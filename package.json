{
  "name": "elcanto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-dev.ps1",
    "dev:render-worker": "node worker/render-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:reasoning": "node scripts/eval-reasoning.mjs",
    "eval:reasoning:suite": "node scripts/eval-reasoning-suite.mjs",
    "eval:reasoning:blind": "node scripts/eval-reasoning-blind.mjs",
    "eval:reasoning:blind:v2": "node scripts/eval-reasoning-blind-v2.mjs",
    "eval:reasoning:reports:v2": "node scripts/generate-reasoning-v2-reports.mjs",
    "eval:reasoning:blind:targeted": "node scripts/eval-reasoning-blind-targeted.mjs",
    "eval:architecture:ab": "vitest run lib/experiments/architecture-ab/architecture-ab.runner.test.ts",
    "eval:final-decision": "vitest run lib/direct-synthesis/final-decision.runner.test.ts",
    "eval:final-decision:case-a": "vitest run lib/direct-synthesis/final-decision.runner.test.ts -t \"Case A only\"",
    "eval:direct-production-smoke": "vitest run lib/direct-synthesis/production-smoke.test.ts",
    "experiment:raw-synthesis": "node scripts/experiment-raw-synthesis.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@base-ui/react": "^1.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "openai": "^7.4.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
