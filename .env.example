# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# ── OpenAI (server-side only) ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_COVERAGE=
OPENAI_MODEL_ANALYSIS=
OPENAI_MODEL_SYNTHESIS=
OPENAI_MODEL_ASK=
# Combined relationship+synthesis in one LLM call (default on for 2-8 sources). Set to 0 to disable.
SYNTHESIS_COMBINED=
SYNTHESIS_COMBINED_MAX_SOURCES=8
# SYNTHESIS_FAST=1 — smaller prompts, fewer deep sections (faster, slightly less depth)
# SYNTHESIS_COVERAGE_RETRY=0 — skip second LLM pass when a voice is missing from results
# SYNTHESIS_ANALYZE_CONCURRENCY=4 — parallel video reads during /synthesize
# Set AI_COST_DEBUG=1 to log per-call token/cost in production
AI_COST_DEBUG=

# ── Google Login ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# YouTube Personal Taste uses youtube.readonly scope (requested on /personal connect).
# Enable YouTube Data API v3 in Google Cloud Console for the same OAuth client.

# ── YouTube Data API (server-side only) ─────────────────────────────────────
YOUTUBE_API_KEY=

# ── Supabase (optional — enables cloud archive + cache) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Railway / local render worker (MP4 export) ───────────────────────────────
LOCAL_RENDER_WORKER_URL=http://localhost:8788
RAILWAY_RENDER_WORKER_URL=
WORKER_SECRET=dev-secret-change-me
RENDER_ALLOW_YTDLP=true
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# ── Render output storage (optional — Supabase Storage or S3) ─────────────────
RENDER_STORAGE_BUCKET=render-outputs
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# ── Cron (optional — background YouTube sync every 6h on Vercel) ───────────────
CRON_SECRET=
